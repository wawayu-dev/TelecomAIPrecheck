# scripts/demo.sh 自动生成被忽略的 .env，或自行复制并填入至少12字符的随机密码。
MYSQL_PORT=13307
FRONTEND_PORT=8088
RELEASE_TAG=local
DB_USERNAME=precheck
DB_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
DEMO_OPERATOR_PASSWORD=replace-with-operator-password
DEMO_REVIEWER_PASSWORD=replace-with-reviewer-password
DEMO_AUDITOR_PASSWORD=replace-with-auditor-password
DEMO_HOST_PASSWORD=replace-with-host-service-password
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=mysql
DEMO_ONE_CLICK_LOGIN=true
# 如需真实 AI，设置下列两项；不配置时仍可演示失败转人工。
# XFYUN_API_KEY=
# XFYUN_MODEL=spark-x2.5
