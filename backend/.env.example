# Spring Boot 不自动读取 .env；请通过 shell export 或 IDE 环境变量注入。
SPRING_PROFILES_ACTIVE=mock
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
CONTEXT_PROVIDER=mock
# 切换 mysql profile 时设置以下变量；不要提交真实密码。
DB_URL='jdbc:mysql://127.0.0.1:3306/telecom_ai_precheck?serverTimezone=Asia/Shanghai&characterEncoding=UTF-8'
DB_USERNAME=precheck
DB_PASSWORD=replace-with-local-password
