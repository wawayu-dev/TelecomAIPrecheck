# Spring Boot 不自动读取 .env；请通过 shell export 或 IDE 环境变量注入。
SPRING_PROFILES_ACTIVE=mock
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
CONTEXT_PROVIDER=mock
# 切换 mysql profile 时设置以下变量；不要提交真实密码。
DB_URL='jdbc:mysql://127.0.0.1:3306/telecom_ai_precheck?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8'
DB_USERNAME=precheck
DB_PASSWORD=replace-with-local-password

# Issue #2：mysql profile 启用预审持久化；以下凭据只放本机环境。
XFYUN_API_KEY=
# 必须使用控制台当前账户已开通的 Model ID，不设假默认值。
XFYUN_MODEL=
XFYUN_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com
XFYUN_COMPLETIONS_PATH=/v2/chat/completions
XFYUN_TIMEOUT_MS=30000
# 真实付费调用测试必须显式开启，默认不运行。
RUN_XFYUN_LIVE=false

# Issue #3：mysql profile 的演示身份，空值表示不创建该账号。
# 使用 scripts/demo.sh 可自动生成本机随机密码；宿主集成时复用宿主认证。
DEMO_OPERATOR_PASSWORD=
DEMO_REVIEWER_PASSWORD=
DEMO_AUDITOR_PASSWORD=
